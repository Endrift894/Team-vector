function getWaitTime(p) {
  if (p.speed === "stopped") return null;
  const r = (p.rate || 1.3) * (p.speed === "fast" ? 1.35 : p.speed === "slow" ? 0.65 : 1);
  return Math.max(0, Math.round(p.people / r));
}

function getWaitColorClass(w) {
  if (w === null) return "gray";
  if (w < 15) return "green";
  if (w <= 30) return "amber";
  return "coral";
}

function escapeHtml(str) {
  return String(str || "").replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
}

function showToast(msg) {
  const t = el("appToast");
  t.textContent = msg;
  t.classList.add("show");
  setTimeout(() => t.classList.remove("show"), 3500);
}

function getMapsDirectionsUrl(name, area) {
  return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(name + ' ' + area)}`;
}

