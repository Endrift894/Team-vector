<style>
/* ========================================================
   MODERN LINE-FREE DESIGN SYSTEM
   Ultra-clean aesthetic: No hard borders or heavy grid outlines.
   Relies on generous whitespace, background shifts (#F8FAFC),
   and soft depth shadows for an uncluttered healthcare interface.
   ======================================================== */
:root {
  --bg: #F4F7FA;
  --surface: #FFFFFF;
  --surface-alt: #F8FAFC;
  --surface-hover: #F1F5F9;
  --ink: #0F172A;
  --muted: #64748B;
  --subtle: #94A3B8;

  /* Primary Palette */
  --primary-teal: #0E7C86;
  --primary-teal-hover: #0a656d;
  --primary-teal-soft: #E6F7F9;
  --header-navy: #0B2A43;

  /* Status & Severity Accents */
  --success-green: #10B981;
  --success-green-bg: #ECFDF5;
  --warning-amber: #F59E0B;
  --warning-amber-bg: #FFFBEB;
  --emergency-coral: #0284C7;
  --emergency-coral-hover: #0369A1;
  --emergency-coral-bg: #E0F2FE;
  --danger-red: #EF4444;
  --danger-red-bg: #FEF2F2;

  /* Facility Category Colors */
  --cat-govt: #2563EB;
  --cat-govt-bg: #EFF6FF;
  --cat-pvt: #7C3AED;
  --cat-pvt-bg: #F5F3FF;
  --cat-clinic: #0D9488;
  --cat-clinic-bg: #F0FDFA;
  --cat-chemist: #059669;
  --cat-chemist-bg: #ECFDF5;

  /* Elevation & Geometry (Line-Free) */
  --radius-sm: 10px;
  --radius-md: 16px;
  --radius-lg: 22px;
  --radius-pill: 9999px;

  --shadow-xs: 0 1px 3px rgba(15, 23, 42, 0.04);
  --shadow-sm: 0 4px 14px -1px rgba(15, 23, 42, 0.05), 0 2px 6px -1px rgba(15, 23, 42, 0.02);
  --shadow-md: 0 10px 25px -3px rgba(15, 23, 42, 0.07), 0 4px 10px -2px rgba(15, 23, 42, 0.03);
  --shadow-lg: 0 20px 40px -4px rgba(15, 23, 42, 0.10), 0 8px 16px -4px rgba(15, 23, 42, 0.04);
}

* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Inter, Helvetica, Arial, sans-serif;
  line-height: 1.5;
  padding-bottom: 76px;
  -webkit-font-smoothing: antialiased;
}

button, input, select, textarea {
  font: inherit;
  border: none;
}
button { cursor: pointer; }
a { text-decoration: none; color: inherit; }

.wrap {
  max-width: 1180px;
  margin: 0 auto;
  padding: 0 18px;
}

/* ========================================================
   HEADER & NAVIGATION
   ======================================================== */
header.app-header {
  height: 64px;
  background: var(--header-navy);
  color: #FFFFFF;
  position: sticky;
  top: 0;
  z-index: 50;
  box-shadow: 0 4px 20px rgba(11, 42, 67, 0.15);
}
.header-inner {
  height: 100%;
  max-width: 1180px;
  margin: 0 auto;
  padding: 0 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 800;
  font-size: 18px;
  letter-spacing: -0.5px;
  color: #FFFFFF;
  user-select: none;
  cursor: pointer;
}
.brand-mark {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border-radius: var(--radius-sm);
  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}
.brand:hover .brand-mark {
  transform: rotate(-6deg) scale(1.08);
}
.brand-name {
  display: flex;
  flex-direction: column;
}
.brand-name-main {
  display: flex;
  align-items: center;
  gap: 4px;
}
.brand-name-main span { color: #5EEAD4; }
.tricity-tag {
  font-size: 10px;
  font-weight: 700;
  background: rgba(94, 234, 212, 0.18);
  color: #5EEAD4;
  padding: 1px 7px;
  border-radius: var(--radius-pill);
  letter-spacing: 0.5px;
  text-transform: uppercase;
}
.header-right {
  display: flex;
  align-items: center;
  gap: 8px;
}
.btn-hdr {
  min-height: 38px;
  padding: 0 14px;
  border-radius: var(--radius-sm);
  font-size: 12.5px;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.1);
  color: #FFFFFF;
  transition: background 0.15s, transform 0.15s;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.btn-hdr:hover {
  background: rgba(255, 255, 255, 0.18);
  transform: translateY(-1px);
}
.btn-hdr-emerg {
  background: #0284C7;
  color: #FFFFFF;
  font-weight: 800;
  box-shadow: 0 4px 12px rgba(2, 132, 199, 0.35);
}
.btn-hdr-emerg:hover {
  background: #0369A1;
}

/* Firebase Realtime Connection Indicator */
.cloud-sync-pill {
  font-size: 11px;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.12);
  color: #E2E8F0;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.cloud-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--success-green);
  box-shadow: 0 0 8px var(--success-green);
}
.cloud-dot.syncing {
  background: var(--warning-amber);
  box-shadow: 0 0 8px var(--warning-amber);
  animation: pulseCloud 1.2s infinite;
}
@keyframes pulseCloud {
  0% { transform: scale(0.9); opacity: 0.7; }
  50% { transform: scale(1.3); opacity: 1; }
  100% { transform: scale(0.9); opacity: 0.7; }
}

/* ========================================================
   STATS STRIP (LINE-FREE)
   ======================================================== */
.stats-strip {
  background: var(--surface);
  box-shadow: var(--shadow-xs);
  padding: 12px 0;
  margin-bottom: 8px;
}
.stats-grid {
  display: flex;
  align-items: center;
  justify-content: space-around;
  gap: 12px;
  text-align: center;
  flex-wrap: wrap;
}
.stat-pill {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: var(--muted);
  font-weight: 600;
}
.stat-pill strong {
  color: var(--ink);
  font-size: 15px;
  font-weight: 800;
}
.stat-dot-green {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--success-green);
  display: inline-block;
  box-shadow: 0 0 6px var(--success-green);
}

/* ========================================================
   FRONT PAGE GATEWAY SCREEN
   ======================================================== */
.gateway-screen {
  padding: 24px 0 36px 0;
}
.gateway-hero {
  text-align: center;
  max-width: 820px;
  margin: 10px auto 30px;
}
.gateway-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.8px;
  text-transform: uppercase;
  background: var(--emergency-coral-bg);
  color: var(--emergency-coral-hover);
  padding: 6px 14px;
  border-radius: var(--radius-pill);
  margin-bottom: 14px;
}
.pulse-beacon {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--emergency-coral);
  box-shadow: 0 0 0 0 rgba(2, 132, 199, 0.7);
  animation: beaconPulse 1.8s infinite;
}
@keyframes beaconPulse {
  0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(2, 132, 199, 0.7); }
  70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(2, 132, 199, 0); }
  100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(2, 132, 199, 0); }
}
.gateway-title {
  font-size: clamp(26px, 4.5vw, 38px);
  font-weight: 900;
  letter-spacing: -0.8px;
  line-height: 1.2;
  margin: 0 0 12px 0;
  color: var(--ink);
}
.gateway-sub {
  font-size: 15px;
  line-height: 1.6;
  color: var(--muted);
  margin: 0 auto;
  max-width: 680px;
}

/* Gateway 2-Split Cards (Line-Free) */
.gateway-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22px;
  margin-bottom: 28px;
}
@media (max-width: 768px) {
  .gateway-grid { grid-template-columns: 1fr; }
}
.gateway-card {
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 32px 28px;
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
  position: relative;
  overflow: hidden;
}
.gateway-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
}
.gateway-card.simple {
  background: linear-gradient(180deg, #FFFFFF 0%, #F0FDFA 100%);
}
.gateway-card.emergency {
  background: linear-gradient(180deg, #FFFFFF 0%, #F0F9FF 100%);
}
.gw-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}
.gw-badge-pill {
  font-size: 11.5px;
  font-weight: 800;
  padding: 5px 12px;
  border-radius: var(--radius-pill);
  display: inline-flex;
  align-items: center;
  gap: 6px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.gw-badge-pill.simple {
  background: #CCFBF1;
  color: #0F766E;
}
.gw-badge-pill.emergency {
  background: #E0F2FE;
  color: #0284C7;
}
.gw-icon-circle {
  width: 60px;
  height: 60px;
  border-radius: var(--radius-md);
  display: grid;
  place-items: center;
  margin-bottom: 18px;
}
.gw-icon-circle.simple {
  background: var(--primary-teal-soft);
  color: var(--primary-teal);
}
.gw-icon-circle.emergency {
  background: var(--emergency-coral-bg);
  color: var(--emergency-coral);
}
.gateway-card h2 {
  font-size: 23px;
  font-weight: 850;
  letter-spacing: -0.4px;
  margin: 0 0 10px;
  color: var(--ink);
}
.gateway-card p.gw-desc {
  font-size: 14px;
  line-height: 1.55;
  color: var(--muted);
  margin: 0 0 20px;
}
.gw-feature-list {
  list-style: none;
  padding: 0;
  margin: 0 0 26px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.gw-feature-list li {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 13.5px;
  color: var(--ink);
}
.gw-chk {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-size: 11px;
  font-weight: 900;
  flex-shrink: 0;
  margin-top: 1px;
}
.gw-chk.simple { background: #CCFBF1; color: #0F766E; }
.gw-chk.emergency { background: #E0F2FE; color: #0284C7; }

.gw-btn {
  width: 100%;
  min-height: 48px;
  border-radius: var(--radius-sm);
  font-size: 14.5px;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition: transform 0.15s, background 0.15s, box-shadow 0.15s;
}
.gw-btn-simple {
  background: var(--primary-teal);
  color: #FFFFFF;
  box-shadow: 0 4px 14px rgba(14, 124, 134, 0.25);
}
.gw-btn-simple:hover {
  background: var(--primary-teal-hover);
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(14, 124, 134, 0.35);
}
.gw-btn-token {
  background: linear-gradient(135deg, #0284C7 0%, #0369A1 100%);
  color: #FFFFFF;
  box-shadow: 0 6px 18px rgba(2, 132, 199, 0.32);
}
.gw-btn-token:hover {
  filter: brightness(1.08);
  transform: translateY(-2px);
}
.gw-btn-emerg-secondary {
  background: var(--surface-alt);
  color: var(--ink);
  margin-top: 8px;
}
.gw-btn-emerg-secondary:hover {
  background: var(--surface-hover);
  transform: translateY(-1px);
}

/* Gateway SOS Strip (Line-Free) */
.gateway-sos-strip {
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 20px 24px;
  box-shadow: var(--shadow-sm);
  margin-bottom: 26px;
}
.gw-sos-heading {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 13.5px;
  font-weight: 800;
  color: var(--ink);
  margin-bottom: 16px;
}
.gw-sos-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
}
@media (max-width: 768px) {
  .gw-sos-grid { grid-template-columns: 1fr 1fr; }
}
.gw-sos-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  border-radius: var(--radius-sm);
  background: var(--surface-alt);
  transition: transform 0.15s, box-shadow 0.15s;
}
.gw-sos-item:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-sm);
}
.gw-sos-item.red { background: #FEF2F2; color: #991B1B; }
.gw-sos-item.blue { background: #EFF6FF; color: #1E40AF; }
.gw-sos-item.green { background: #ECFDF5; color: #065F46; }
.gw-sos-item.amber { background: #FFFBEB; color: #92400E; }
.gw-sos-item strong {
  display: block;
  font-size: 13.5px;
  font-weight: 800;
  line-height: 1.2;
}
.gw-sos-item small {
  display: block;
  font-size: 11px;
  opacity: 0.85;
  margin-top: 2px;
}

/* ========================================================
   ACTIVE EMERGENCY TOKEN HUD (LINE-FREE)
   ======================================================== */
.active-token-hud {
  background: linear-gradient(135deg, #071D2E 0%, #0B2A43 60%, #0E4856 100%);
  color: #FFFFFF;
  border-radius: var(--radius-md);
  padding: 16px 22px;
  margin: 12px 0 20px 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  box-shadow: var(--shadow-md);
}
@media (max-width: 640px) {
  .active-token-hud { flex-direction: column; align-items: stretch; text-align: center; }
}
.hud-left {
  display: flex;
  align-items: center;
  gap: 14px;
}
.hud-pulse-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: #38BDF8;
  box-shadow: 0 0 12px #38BDF8;
  animation: beaconPulse 1.4s infinite;
  flex-shrink: 0;
}
.hud-title {
  font-size: 14px;
  font-weight: 800;
}
.hud-title strong {
  color: #7DD3FC;
  background: rgba(125, 211, 252, 0.16);
  padding: 2px 8px;
  border-radius: 6px;
  font-family: ui-monospace, monospace;
  font-size: 15px;
  margin-left: 4px;
}
.hud-sub {
  font-size: 12px;
  color: #CBD5E1;
  margin-top: 3px;
}
.hud-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
  justify-content: center;
}
.hud-btn-pass {
  background: #38BDF8;
  color: #071D2E;
  font-size: 12.5px;
  font-weight: 800;
  padding: 8px 16px;
  border-radius: var(--radius-sm);
  transition: transform 0.15s;
}
.hud-btn-pass:hover { transform: scale(1.04); background: #7DD3FC; }
.hud-btn-call {
  background: rgba(255, 255, 255, 0.15);
  color: #FFFFFF;
  font-size: 12.5px;
  font-weight: 700;
  padding: 8px 14px;
  border-radius: var(--radius-sm);
}

/* ========================================================
   SEARCH BAR & AUTOCOMPLETE (LINE-FREE)
   ======================================================== */
.search-block {
  margin: 18px 0 14px;
  position: relative;
}
.search-input-wrap {
  display: flex;
  align-items: center;
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 6px 10px 6px 18px;
  box-shadow: var(--shadow-sm);
  transition: box-shadow 0.2s, background 0.2s;
}
.search-input-wrap:focus-within {
  box-shadow: 0 8px 24px -2px rgba(14, 124, 134, 0.20);
  background: #FFFFFF;
}
.search-input-wrap .search-ico {
  color: var(--muted);
  font-size: 18px;
  margin-right: 10px;
}
.search-input-wrap input {
  flex: 1;
  min-width: 0;
  background: transparent;
  font-size: 15px;
  min-height: 42px;
  color: var(--ink);
  outline: 0;
}
.search-input-wrap .clear-btn {
  background: var(--surface-hover);
  color: var(--muted);
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-size: 14px;
  margin-right: 6px;
}

/* Autocomplete Suggestions Popup */
.suggestions-box {
  position: absolute;
  top: calc(100% + 8px);
  left: 0;
  right: 0;
  background: var(--surface);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-lg);
  z-index: 60;
  overflow: hidden;
  display: none;
}
.suggestions-box.show { display: block; }
.sug-item {
  padding: 12px 18px;
  font-size: 13.5px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  transition: background 0.15s;
}
.sug-item:hover, .sug-item.active { background: var(--surface-hover); }
.sug-item b { color: var(--primary-teal); }
.sug-tag {
  font-size: 11px;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: var(--radius-pill);
  background: var(--surface-alt);
  color: var(--muted);
  text-transform: uppercase;
}

/* ========================================================
   QUICK FILTER CHIPS & CATEGORY TABS (LINE-FREE)
   ======================================================== */
.quick-chips-row {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding: 4px 0 14px;
  scrollbar-width: none;
}
.quick-chips-row::-webkit-scrollbar { display: none; }
.chip {
  flex-shrink: 0;
  min-height: 38px;
  padding: 0 16px;
  border-radius: var(--radius-pill);
  background: var(--surface);
  color: var(--ink);
  font-size: 13px;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  box-shadow: var(--shadow-xs);
  transition: all 0.15s;
}
.chip:hover {
  background: var(--surface-hover);
  transform: translateY(-1px);
}
.chip.active {
  background: var(--primary-teal);
  color: #FFFFFF;
  box-shadow: 0 4px 12px rgba(14, 124, 134, 0.3);
}

.filter-bar {
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 14px 18px;
  margin-bottom: 20px;
  box-shadow: var(--shadow-sm);
}
.filter-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
}
.category-tabs {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}
.cat-tab {
  background: var(--surface-alt);
  color: var(--muted);
  font-size: 12.5px;
  font-weight: 700;
  padding: 8px 14px;
  border-radius: var(--radius-sm);
  min-height: 38px;
  transition: all 0.15s;
}
.cat-tab:hover {
  color: var(--ink);
  background: var(--surface-hover);
}
.cat-tab.active {
  background: var(--header-navy);
  color: #FFFFFF;
}
.filter-actions-right {
  display: flex;
  align-items: center;
  gap: 12px;
}
.toggle-switch-label {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 700;
  color: var(--ink);
  cursor: pointer;
  user-select: none;
}
.toggle-switch {
  width: 38px;
  height: 22px;
  background: #CBD5E1;
  border-radius: var(--radius-pill);
