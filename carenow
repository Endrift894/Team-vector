// 1. ARCHITECTURE & FIREBASE INTEGRATION WITH 24-HOUR EXPIRY
// ========================================================

/**
 * FIREBASE CONFIGURATION INSTRUCTIONS:
 * To enable real-time cloud sync across devices, replace the placeholders below
 * with your own Firebase Project settings (from Firebase Console -> Project Settings -> General -> Your apps -> Web app).
 * If left with default placeholders, the application runs flawlessly in local-offline mode!
 */
const firebaseConfig = {
  apiKey: "YOUR_FIREBASE_API_KEY",
  authDomain: "YOUR_PROJECT_ID.firebaseapp.com",
  databaseURL: "https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com",
  projectId: "YOUR_PROJECT_ID",
  storageBucket: "YOUR_PROJECT_ID.appspot.com",
  messagingSenderId: "YOUR_SENDER_ID",
  appId: "YOUR_APP_ID"
};

let db = null;
let isFirebaseConnected = false;

// 24-Hour Expiry Window: 86,400,000 milliseconds
const EXPIRY_24_HOURS_MS = 86400000;

function isOlderThan24Hours(isoTimestamp) {
  if (!isoTimestamp) return true;
  const time = new Date(isoTimestamp).getTime();
  if (isNaN(time)) return true;
  return (Date.now() - time) > EXPIRY_24_HOURS_MS;
}

/**
 * Automated 24-Hour Expiry Cleaner Function:
 * Filters out stale crowdsourced queue reports, false claims, and emergency tokens.
 */
function cleanStale24HourData() {
  const now = Date.now();
  let cleanedCount = 0;

  // Clean false-claims older than 24 hours
  const initialFalseClaimCount = falseClaims.length;
  falseClaims = falseClaims.filter(fc => {
    const age = now - new Date(fc.createdAt || fc.at || 0).getTime();
    return age < EXPIRY_24_HOURS_MS;
  });
  if (falseClaims.length !== initialFalseClaimCount) {
    saveFalseClaims();
    cleanedCount += (initialFalseClaimCount - falseClaims.length);
  }

  // Clean active emergency token if older than 24 hours
  if (activeEmergencyToken) {
    const tokenAge = now - new Date(activeEmergencyToken.createdAt || 0).getTime();
    if (tokenAge >= EXPIRY_24_HOURS_MS) {
      saveActiveEmergencyToken(null);
      cleanedCount++;
    }
  }

  // Check place crowdsourced updates: if older than 24 hours, reset to default state
  places.forEach(p => {
    if (p.reportTimestamp && isOlderThan24Hours(p.reportTimestamp)) {
      const base = tricityInitialPlaces.find(x => x.id === p.id);
      if (base) {
        p.people = base.people;
        p.rate = base.rate;
        p.speed = "normal";
        p.lastVerified = 60;
        delete p.reportTimestamp;
        cleanedCount++;
      }
    }
  });

  if (cleanedCount > 0) {
    savePlaces();
    console.log(`[24-Hour Expiry Policy] Purged ${cleanedCount} stale records older than 24 hours.`);
  }
}

function initFirebase() {
  try {
    if (firebaseConfig.apiKey && firebaseConfig.apiKey !== "YOUR_FIREBASE_API_KEY") {
      firebase.initializeApp(firebaseConfig);
      db = firebase.database();
      isFirebaseConnected = true;
      console.log("[Firebase] Successfully initialized real-time database connection.");

      // Sync places from Firebase
      db.ref("tricity_places").on("value", snapshot => {
        const val = snapshot.val();
        if (val && Array.isArray(val) && val.length > 0) {
          places = val;
          cleanStale24HourData();
          savePlaces();
          render();
        }
      });

      // Sync false claims with 24h filter
      db.ref("tricity_false_claims").on("value", snapshot => {
        const val = snapshot.val();
        if (val && Array.isArray(val)) {
          falseClaims = val.filter(fc => !isOlderThan24Hours(fc.createdAt));
          saveFalseClaims();
          render();
        }
      });
    }
  } catch (err) {
    console.warn("[Firebase] Operating in offline/local storage mode:", err.message);
    isFirebaseConnected = false;
  }
}

