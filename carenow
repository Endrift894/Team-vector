/**
 * Parses uploaded Excel (.xlsx, .xls) or CSV files into the app state
 * and syncs them automatically with Firebase.
 */
function handleExcelUpload(event) {
  const file = event.target.files[0];
  if (!file) return;

  const reader = new FileReader();
  reader.onload = function(e) {
    try {
      const data = new Uint8Array(e.target.result);
      const workbook = XLSX.read(data, { type: 'array' });
      const firstSheetName = workbook.SheetNames[0];
      const worksheet = workbook.Sheets[firstSheetName];
      const rawRows = XLSX.utils.sheet_to_json(worksheet);

      if (!rawRows || rawRows.length === 0) {
        showToast("Uploaded spreadsheet contains no data rows.");
        return;
      }

      // Parse and map rows flexibly
      const importedPlaces = rawRows.map((row, index) => {
        const name = row.Name || row.name || row["Hospital Name"] || `Facility ${index + 1}`;
        const cat = (row.Category || row.cat || "govt_hospital").toLowerCase().includes("pvt") ? "pvt_hospital" :
                    (row.Category || row.cat || "").toLowerCase().includes("clinic") ? "clinic" :
                    (row.Category || row.cat || "").toLowerCase().includes("chemist") ? "chemist" : "govt_hospital";
        const categoryLabel = row.CategoryLabel || row.categoryLabel || (cat === "pvt_hospital" ? "Private Hospital" : cat === "clinic" ? "Clinic" : "Govt Hospital");
        const area = row.Area || row.area || row.Location || "Chandigarh Tricity";
        const is24x7 = String(row.is24x7 || row["24x7"] || row.Open24x7 || "true").toLowerCase() === "true" || String(row.is24x7) === "1";
        const timings = row.Timings || row.timings || (is24x7 ? "24x7 Open" : "9:00 AM – 5:00 PM");
        const fee = row.Fee || row.fee || (cat === "govt_hospital" ? "Free / ₹10 OPD slip" : "₹500 - ₹1000");
        const minFee = Number(row.MinFee || row.minFee || 0);
        const people = Number(row.People || row.people || row["Waiting"] || 10);
        const rate = Number(row.Rate || row.rate || 1.3);
        const phone = String(row.Phone || row.phone || "0172-2756565");

        return {
          id: Date.now() + index,
          name,
          cat,
          categoryLabel,
          area,
          is24x7,
          timings,
          fee,
          minFee,
          people,
          rate,
          phone,
          lastVerified: 1,
          createdAt: new Date().toISOString()
        };
      });

      places = importedPlaces;
      savePlaces();
      closeExcelModal();
      render();
      showToast(`Successfully imported ${importedPlaces.length} Tricity facilities!`);
    } catch (err) {
      console.error("[SheetJS Upload Error]", err);
      showToast("Error reading file. Ensure it is a valid Excel or CSV sheet.");
    }
  };
  reader.readAsArrayBuffer(file);
}

// Export Tricity Data back to Excel
function exportTricityToExcel() {
  try {
    const exportData = places.map(p => ({
      ID: p.id,
      Name: p.name,
      Category: p.cat,
      CategoryLabel: p.categoryLabel,
      Area: p.area,
      "24x7": p.is24x7 ? "Yes" : "No",
      Timings: p.timings,
      Fee: p.fee,
      MinFee: p.minFee,
      "People in Queue": p.people,
      Phone: p.phone,
      "Last Verified (mins)": p.lastVerified
    }));

    const ws = XLSX.utils.json_to_sheet(exportData);
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, "Tricity Facilities");
    XLSX.writeFile(wb, "CareNow_Chandigarh_Tricity_Data.xlsx");
    showToast("Downloaded CareNow_Chandigarh_Tricity_Data.xlsx");
  } catch (err) {
    showToast("Failed to export Excel file.");
  }
}

