                      <div>
                        <div class="doc-name">${escapeHtml(d.name)}</div>
                        <div class="doc-spec">${escapeHtml(d.speciality)} · ${escapeHtml(d.days)}</div>
                      </div>
                      <div style="text-align:right;">
                        <div style="font-weight:800;">${d.fee === 0 ? "Free OPD" : "₹" + d.fee}</div>
                        <div style="font-size:11px;color:var(--muted);">${escapeHtml(d.hours)}</div>
                      </div>
                    </div>
                  `).join("")}
                </div>
              ` : ""}

              <div class="card-actions-row">
                <a href="tel:${escapeHtml(p.phone)}" class="btn-call">📞 Call</a>
                <a href="${getMapsDirectionsUrl(p.name, p.area)}" target="_blank" rel="noopener noreferrer" class="btn-directions">🧭 Directions</a>
                <button class="btn-report-link" onclick="openReportModal(${p.id})">📝 Report queue</button>
                <button class="btn-flag-link" onclick="openFalseClaimModal(${p.id})">Report false claim</button>
              </div>

              <div class="verified-note">
                Verified ${p.lastVerified} mins ago · ~${p.people} waiting in line
                ${getFalseClaimCount(p.id) ? `<span class="false-claim-badge">⚠ ${getFalseClaimCount(p.id)} report</span>` : ""}
              </div>
            </article>
          `;
        }).join("")}
      </div>
    </div>
  `;

  // Search input binding
  const sInput = el("mainSearchInput");
  if (sInput) {
    sInput.oninput = e => {
      searchQuery = e.target.value;
      render();
    };
  }
}

function setQuickChip(chipName) {
  activeQuickChip = (activeQuickChip === chipName) ? "" : chipName;
  render();
}

function toggleDoctorDrawer(id) {
  const d = el(`drawer-${id}`);
  if (d) d.classList.toggle("open");
}

function renderActiveTokenHUDHTML() {
  if (!activeEmergencyToken) return "";
  return `
    <div class="active-token-hud">
      <div class="hud-left">
        <span class="hud-pulse-dot"></span>
        <div>
          <div class="hud-title">ACTIVE TRICITY ER TOKEN: <strong>${activeEmergencyToken.tokenId}</strong></div>
          <div class="hud-sub">🏥 ${escapeHtml(activeEmergencyToken.hospitalName)} · Queue #${activeEmergencyToken.queueNumber} · Issued: ${new Date(activeEmergencyToken.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</div>
        </div>
      </div>
      <div class="hud-actions">
        <button class="hud-btn-pass" onclick="openTokenPassModal()">🎫 View Pass</button>
        <a href="tel:${escapeHtml(activeEmergencyToken.hospitalPhone)}" class="hud-btn-call">📞 Call ER</a>
      </div>
    </div>
  `;
}

// ========================================================
// 6. MODAL HANDLERS & 24-HOUR CROWDSOURCING
// ========================================================

// EXCEL MODAL
function openExcelModal() {
  el("excelUploaderBackdrop").classList.add("show");
}
function closeExcelModal() {
  el("excelUploaderBackdrop").classList.remove("show");
}
el("closeExcelModalBtn").onclick = closeExcelModal;
el("btnExportExcel").onclick = exportTricityToExcel;
el("btnResetDefaultData").onclick = () => {
  if (confirm("Reset dataset back to official Chandigarh Tricity government facilities?")) {
    places = JSON.parse(JSON.stringify(tricityInitialPlaces));
    savePlaces();
    closeExcelModal();
    render();
    showToast("Restored official Chandigarh Tricity facilities.");
  }
};

// REPORT QUEUE MODAL
function openReportModal(defaultPlaceId) {
  const sel = el("selectPlaceToReport");
  sel.innerHTML = places.map(p => `<option value="${p.id}" ${p.id === defaultPlaceId ? "selected" : ""}>${escapeHtml(p.name)} (${escapeHtml(p.area)})</option>`).join("");
  el("reportNoteInput").value = "";
  el("reportBackdrop").classList.add("show");
}
function closeReportModal() { el("reportBackdrop").classList.remove("show"); }
el("closeReportModalBtn").onclick = closeReportModal;
el("reportForm").onsubmit = e => {
  e.preventDefault();
  const placeId = Number(el("selectPlaceToReport").value);
  const p = places.find(x => x.id === placeId);
  if (p) {
    p.people = Number(el("queueNumberInput").value);
    p.speed = el("lineSpeedInput").value;
    p.note = el("reportNoteInput").value.trim();
    p.lastVerified = 0;
    p.reportTimestamp = new Date().toISOString(); // Timestamp for 24h expiry
    savePlaces();
    closeReportModal();
    render();
    showToast(`Queue report recorded for ${p.name}! (Valid for 24 hours)`);
  }
};

// FALSE CLAIM MODAL
function openFalseClaimModal(defaultPlaceId) {
  const sel = el("selectPlaceToFlag");
  sel.innerHTML = places.map(p => `<option value="${p.id}" ${p.id === defaultPlaceId ? "selected" : ""}>${escapeHtml(p.name)} (${escapeHtml(p.area)})</option>`).join("");
  el("falseClaimDetails").value = "";
  el("falseClaimBackdrop").classList.add("show");
}
function closeFalseClaimModal() { el("falseClaimBackdrop").classList.remove("show"); }
el("closeFalseClaimModalBtn").onclick = closeFalseClaimModal;
el("falseClaimForm").onsubmit = e => {
  e.preventDefault();
  const placeId = Number(el("selectPlaceToFlag").value);
  const p = places.find(x => x.id === placeId);
  const details = el("falseClaimDetails").value.trim();
  if (p && details) {
    falseClaims.unshift({
      id: Date.now(),
      placeId: p.id,
      placeName: p.name,
      claimType: el("falseClaimType").value,
      details,
      createdAt: new Date().toISOString() // 24-hour timestamp
    });
    saveFalseClaims();
    closeFalseClaimModal();
    render();
    showToast(`False claim report submitted for ${p.name}. Thank you!`);
  }
};

// TOKEN GENERATOR MODAL
function openTokenGeneratorModal(defaultHospitalId) {
  const sel = el("selectTokenHospital");
  const emergHospitals = places.filter(p => p.is24x7);
  sel.innerHTML = emergHospitals.map(h => `<option value="${h.id}" ${h.id === defaultHospitalId ? "selected" : ""}>${escapeHtml(h.name)} (${escapeHtml(h.area)})</option>`).join("");

  el("tokenPatientName").value = "Sunil Kumar";
  el("tokenPatientPhone").value = "9814000000";
  el("tokenChiefComplaint").value = "Severe chest pain & shortness of breath";
  el("tokenGeneratorBackdrop").classList.add("show");
}
function closeTokenGenModal() { el("tokenGeneratorBackdrop").classList.remove("show"); }
el("closeTokenGenModalBtn").onclick = closeTokenGenModal;

// Triage chips selection
document.querySelectorAll("#triageSeverityGrid .chip").forEach(chip => {
  chip.onclick = () => {
    document.querySelectorAll("#triageSeverityGrid .chip").forEach(c => c.classList.remove("active"));
    chip.classList.add("active");
    el("selectedSeverityInput").value = chip.dataset.sev;
  };
});

el("tokenGenForm").onsubmit = e => {
  e.preventDefault();
  const hospId = Number(el("selectTokenHospital").value);
  const hosp = places.find(p => p.id === hospId) || places[0];
  const randCode = "CHD-" + Math.floor(100 + Math.random() * 900);

  const token = {
    tokenId: randCode,
    createdAt: new Date().toISOString(), // ISO timestamp with 24-hour expiry check
    hospitalId: hosp.id,
    hospitalName: hosp.name,
    hospitalArea: hosp.area,
    hospitalPhone: hosp.phone,
    patientName: el("tokenPatientName").value.trim(),
    patientPhone: el("tokenPatientPhone").value.trim(),
    severity: el("selectedSeverityInput").value,
    chiefComplaint: el("tokenChiefComplaint").value.trim(),
    arrivalEta: el("tokenEtaInput").value,
    queueNumber: 2
  };

  saveActiveEmergencyToken(token);
  closeTokenGenModal();
  render();
  openTokenPassModal();
  showToast(`Token ${randCode} transmitted to ${hosp.name} casualty desk!`);
};

// TOKEN PASS MODAL
function openTokenPassModal() {
  if (!activeEmergencyToken) {
    openTokenGeneratorModal();
    return;
  }
  const t = activeEmergencyToken;
  el("passTokenCode").textContent = t.tokenId;
  el("passHospitalName").textContent = t.hospitalName;
  el("passHospitalArea").textContent = t.hospitalArea;
  el("passSeverityBadge").textContent = t.severity.toUpperCase() === "P1" ? "Priority 1 (Critical)" : "Priority 2 (Urgent)";
  el("passPatientName").textContent = t.patientName + (t.patientPhone ? ` (${t.patientPhone})` : "");
  el("passArrivalEta").textContent = t.arrivalEta;
  el("passChiefComplaint").textContent = t.chiefComplaint;

  el("passCallHospitalBtn").href = `tel:${t.hospitalPhone}`;
  el("passDirectionsBtn").href = getMapsDirectionsUrl(t.hospitalName, t.hospitalArea);

  el("tokenPassBackdrop").classList.add("show");
}
function closeTokenPassModal() { el("tokenPassBackdrop").classList.remove("show"); }
el("closeTokenPassModalBtn").onclick = closeTokenPassModal;

el("passShareBtn").onclick = () => {
  if (!activeEmergencyToken) return;
  const msg = `[CHANDIGARH TRICITY ER PASS: ${activeEmergencyToken.tokenId}]\nPatient: ${activeEmergencyToken.patientName}\nHospital: ${activeEmergencyToken.hospitalName}\nPhone: ${activeEmergencyToken.hospitalPhone}\nETA: ${activeEmergencyToken.arrivalEta}`;
  navigator.clipboard ? navigator.clipboard.writeText(msg).then(() => showToast("Copied pass to clipboard!")) : showToast(msg);
};

el("passDischargeBtn").onclick = () => {
  if (confirm("Mark this emergency intake token as completed or discharged?")) {
    saveActiveEmergencyToken(null);
    closeTokenPassModal();
    render();
    showToast("Emergency token cleared.");
  }
};

// Mobile Bottom Bar Navigation
el("mBtnHome").onclick = () => setMode("gateway");
el("mBtnSearch").onclick = () => setMode("simple");
el("mBtnEmergency").onclick = () => setMode("emergency");
el("mBtnExcel").onclick = openExcelModal;

// Initialize app & Firebase
initFirebase();
cleanStale24HourData();
render();
</script>
</body>
</html>
